# ── 슬랙 (권장: Incoming Webhook) ────────────────────────────
# https://api.slack.com/apps → Create New App → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK_URL=

# 채널 분리하고 싶으면 아래를 각각 채우면 됨 (비우면 위 기본 웹훅으로 전부 감)
SLACK_WEBHOOK_TREND=
SLACK_WEBHOOK_PUMP=
SLACK_WEBHOOK_STOCK=

# ── 선택: 급등 "이유"를 자연어로 다듬을 때 (없어도 규칙기반 설명은 나옴) ──
GEMINI_API_KEY=
