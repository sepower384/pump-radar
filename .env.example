# ── 슬랙 (권장: Incoming Webhook) ────────────────────────────
# https://api.slack.com/apps → Create New App → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK_URL=

# 채널 분리하고 싶으면 아래를 각각 채우면 됨 (비우면 위 기본 웹훅으로 전부 감)
SLACK_WEBHOOK_TREND=
SLACK_WEBHOOK_PUMP=
SLACK_WEBHOOK_STOCK=

# ── 선택: 급등 "이유"를 자연어로 다듬을 때 (없어도 규칙기반 설명은 나옴) ──
GEMINI_API_KEY=

# ── 텔레그램 (슬랙과 동시 발송, 비우면 건너뜀) ──────────────────
# 봇 토큰: kind별 전용 봇이 있으면 _PUMP/_TREND/_STOCK, 없으면 공용 TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_PUMP=
TELEGRAM_BOT_TOKEN_TREND=
TELEGRAM_BOT_TOKEN_STOCK=
# 슈퍼그룹 id (-100…) 와 토픽 스레드 id
TELEGRAM_CHAT_ID=
# kind별 전용 방(채널·그룹) — 있으면 위 공용 CHAT_ID 대신 사용 (run_once.py chats 로 id 조회)
TELEGRAM_CHAT_ID_PUMP=
TELEGRAM_CHAT_ID_TREND=
TELEGRAM_CHAT_ID_STOCK=
TELEGRAM_TOPIC_PUMP=
TELEGRAM_TOPIC_TREND=
TELEGRAM_TOPIC_STOCK=

# 선택: 만족도 조사에서 받은 자유 피드백(봇 1:1 메시지)을 넘길 운영자 채팅 id
# 비우면 전달하지 않고 건수만 기록한다. 원문은 공개 저장소(history 브랜치)에 남기지 않는다.
TELEGRAM_ADMIN_CHAT_ID=
